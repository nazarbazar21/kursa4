@{
    ViewData["Title"] = "Головна";
}
<section class="hero">
    <div>
        <h1>Інтернет-магазин на ASP.NET Core</h1>
        <p>Каталог товарів, кошик, реєстрація користувачів та оформлення замовлення з використанням SQL Server.</p>
        <a class="btn" asp-controller="Products" asp-action="Index">Перейти до каталогу</a>
    </div>
</section>
<section class="features">
    <div><b>Каталог</b><span>Перегляд і пошук товарів</span></div>
    <div><b>Кошик</b><span>Додавання товарів до покупки</span></div>
    <div><b>Замовлення</b><span>Оформлення заявки клієнта</span></div>
</section>
