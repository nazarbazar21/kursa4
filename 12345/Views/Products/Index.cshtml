@model List<Product>
@{
    ViewData["Title"] = "Каталог";
}
<h1>Каталог товарів</h1>
<form class="filter" method="get">
    <input name="search" placeholder="Пошук товару" />
    <select name="categoryId">
        <option value="">Усі категорії</option>
        @foreach (var category in ViewBag.Categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
    <button class="btn" type="submit">Знайти</button>
</form>
<div class="grid">
@foreach (var product in Model)
{
    <article class="card">
        <div class="image-box">@product.Name.Substring(0, 1)</div>
        <h3>@product.Name</h3>
        <p>@product.Description</p>
        <span class="category">@product.Category?.Name</span>
        <div class="price">@product.Price грн</div>
        <a class="btn" asp-controller="Cart" asp-action="Add" asp-route-productId="@product.Id">До кошика</a>
    </article>
}
</div>
